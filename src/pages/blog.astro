---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Articles" description="Stories, reflections, and resources from People's Zoom Readers Theater.">
  <section class="page-heading container"><span class="eyebrow">From our community</span><h1>Articles &<br /><em>reflections.</em></h1><p>Stories, perspectives, and resources beyond the performance.</p></section>
  <section class="container section section-topless">
    <p class="preview-note">A first look at our article archive. Some articles are excerpts during migration; each links to its complete original.</p>
    <div class="card-grid">{articles.map((article) => <ArticleCard article={article} />)}</div>
    {articles.length === 0 && <p>No articles are published yet.</p>}
  </section>
</Layout>
