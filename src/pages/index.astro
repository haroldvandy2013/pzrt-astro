---
import Layout from '../layouts/Layout.astro';
import PosterCarousel from '../components/PosterCarousel.astro';
import GetInvolved from '../components/GetInvolved.astro';
import { site } from '../lib/site';

const accents = ['a diverse group', 'in the hope of bringing'];
---
<Layout title="Home">
  <section id="who-we-are" class="who-we-are">
    <div class="intro-content">
      <h1>Who We Are</h1>
      {site.intro.map((paragraph, index) => {
        const marker = accents[index];
        const accentStart = marker ? paragraph.indexOf(marker) : -1;
        return <p>{accentStart >= 0 ? <>{paragraph.slice(0, accentStart)}<span class="intro-accent">{paragraph.slice(accentStart)}</span></> : paragraph}</p>;
      })}
    </div>
    <PosterCarousel />
  </section>
  <section class="home-contact"><GetInvolved /></section>
</Layout>
