---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import { channelUrl } from '../lib/site';
const videos = (await getCollection('videos', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
---
<Layout title="Performance Videos" description="Watch People's Zoom Readers Theater performances on YouTube.">
  <h1 class="sr-only">Performance Videos</h1>
  <section class="container video-archive">
    <div class="archive-toolbar"><span>All Videos</span></div>
    <div class="video-grid">{videos.map((video) => <VideoCard video={video} />)}</div>
    {videos.length === 0 && <p>No performances are published yet. Visit our YouTube channel above.</p>}
    <div class="archive-footnote"><a href={channelUrl} target="_blank" rel="noopener noreferrer">More videos on YouTube <span class="sr-only"> (opens in a new tab)</span></a><p>This preview includes a selection, not the complete archive. Videos load from YouTube when you choose “Play here”.</p></div>
  </section>
</Layout>
