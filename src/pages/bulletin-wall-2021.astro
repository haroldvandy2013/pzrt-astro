---
import Layout from '../layouts/Layout.astro';
import { site, contactHref } from '../lib/site';
import { padletUrl } from '../lib/urls.mjs';
const board = padletUrl(site.padletUrl);
---
<Layout title="Bulletin Wall" description="A shared space for People's Zoom Readers Theater community conversations.">
  <h1 class="sr-only">Bulletin Wall</h1>
  <section class="container bulletin-page">
    {board ? (
      <div class="padlet-board"><iframe src={board} title="PZRT community bulletin wall on Padlet" allow="clipboard-write" referrerpolicy="strict-origin-when-cross-origin"></iframe><p>Having trouble viewing the board? <a class="text-link" href={board} target="_blank" rel="noopener noreferrer">Open it on Padlet <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></p></div>
    ) : (
      <div class="empty-board">
        <div class="empty-board-art" aria-hidden="true"><span class="paper paper-one"></span><span class="paper paper-two"></span><span class="paper paper-three"></span></div>
        <span class="status-label"><span class="live-dot"></span> Not connected yet</span>
        <h2>Bulletin Wall</h2>
        <p>The Padlet bulletin wall is not connected. Posting is not available here until a board URL is configured.</p>
        <p class="empty-board-detail">The board will appear here once it has been connected. In the meantime, we’d love to hear from you by email.</p>
        <a class="button" href={contactHref}>Get in touch <span aria-hidden="true">↗</span></a>
      </div>
    )}
  </section>
</Layout>
