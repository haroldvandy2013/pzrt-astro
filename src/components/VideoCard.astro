---
import type { CollectionEntry } from 'astro:content';
import { youtubeId } from '../lib/urls.mjs';

interface Props { video: CollectionEntry<'videos'>; }
const { video } = Astro.props;
const id = youtubeId(video.data.youtube);
---
<article class="video-card">
  <div class="video-frame">
    <a class="video-cover" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener noreferrer">
      <img src={`https://i.ytimg.com/vi/${id}/mqdefault.jpg`} srcset={`https://i.ytimg.com/vi/${id}/mqdefault.jpg 1x, https://i.ytimg.com/vi/${id}/maxresdefault.jpg 2x`} alt="" width="320" height="180" loading="lazy" />
      <span class="play-icon" aria-hidden="true">▶</span>
      <span class="sr-only">Watch {video.data.title} on YouTube (opens in a new tab)</span>
      {video.data.duration && <span class="video-duration">{video.data.duration}</span>}
    </a>
    <button hidden class="video-load" data-video-id={id} data-video-title={video.data.title} aria-label={`Play Video: ${video.data.title}`}><span aria-hidden="true">▷</span></button>
  </div>
  <div class="card-body">
    <h3><a class="video-title-link" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener noreferrer">{video.data.title}</a></h3>
    {video.data.description && <p class="video-description">{video.data.description}</p>}
    <p class="full-video-description" hidden>{video.data.description || ''}</p>
  </div>
</article>
