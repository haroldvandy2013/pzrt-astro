---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  width?: number;
  class?: string;
  eager?: boolean;
  sizes?: string;
}
const { src, alt, width = 1200, class: className, eager = false, sizes = '100vw' } = Astro.props;
const media = import.meta.glob<{ default: ImageMetadata }>('/public/media/**/*.{jpg,jpeg,png,webp,gif}', { eager: true });
const source = media[`/public${src}`]?.default;
if (!source) throw new Error(`Image not found: ${src}. Upload it to public/media.`);
---
<Image
  src={source}
  alt={alt}
  width={Math.min(width, source.width)}
  widths={[320, 640, 960, 1200].filter((size) => size <= source.width)}
  sizes={sizes}
  format="webp"
  quality={85}
  class={className}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
/>
