---
import { site, href, contactHref, channelUrl } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description = site.tagline, image = site.contactImage } = Astro.props;
const path = Astro.url.pathname;
const navigation = [
  { label: 'Home', url: '/' },
  { label: 'Performance Videos', url: '/videos/' },
  { label: 'Articles', url: '/blog/' },
  { label: 'Bulletin Wall', url: '/bulletin-wall-2021/' },
];
const canonical = new URL(path, Astro.site);
const socialImage = new URL(href(image), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Home' ? site.name : `${title} | ${site.name}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#122653" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href('/')} aria-label={`${site.name} — home`}>
          <img src={href(site.logo)} alt="" width="129" height="87" />
          <span class="brand-text"><span class="brand-name">{site.name}</span><span class="brand-tagline">{site.tagline}</span></span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-navigation">Menu <span aria-hidden="true">☰</span></button>
        <nav id="site-navigation" aria-label="Main navigation">
          {navigation.map(({ label, url }) => (
            <a href={href(url)} aria-current={path === href(url) || (url === '/blog/' && path.includes('/post/')) ? 'page' : undefined}>{label}</a>
          ))}
          <a href={contactHref}>Contact Us</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-socials" aria-label="Social media">
        <a href="https://www.facebook.com/Peoples-Zoom-Readers-Theater-100664028686156" target="_blank" rel="noopener noreferrer" aria-label="Facebook (opens in a new tab)"><img src={href('/media/facebook.png')} alt="" width="20" height="20" /></a>
        <a href="https://twitter.com/pzrt2014" target="_blank" rel="noopener noreferrer" aria-label="Twitter (opens in a new tab)"><img src={href('/media/twitter.png')} alt="" width="20" height="20" /></a>
        <a href="https://www.linkedin.com/company/peoples-zoom-readers-theater" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)"><img src={href('/media/linkedin.png')} alt="" width="20" height="20" /></a>
        <a href={channelUrl} target="_blank" rel="noopener noreferrer" aria-label="YouTube (opens in a new tab)"><img src={href('/media/youtube.png')} alt="" width="20" height="20" /></a>
      </div>
      <p>©{new Date().getFullYear()} by {site.name}.</p>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.getElementById('site-navigation');
      nav?.classList.add('js-ready');
      toggle?.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        nav?.classList.toggle('is-open', !expanded);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          toggle.setAttribute('aria-expanded', 'false');
          nav?.classList.remove('is-open');
          toggle.focus();
        }
      });
    </script>
  </body>
</html>
